<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Redefinir senha - Biomassa Hub</title>
  <link rel="stylesheet" href="/css/login.css">
  <link href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/darkmode.css">
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#1b814e">
  <link rel="apple-touch-icon" href="/imagem/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/imagem/favicon-32.png">
  <link rel="icon" type="image/png" sizes="192x192" href="/imagem/icon-192.png">
  <link rel="icon" type="image/png" sizes="512x512" href="/imagem/icon-512.png">
</head>
<body>
  <main class="login-main">

    <aside class="hero-section">
      <header class="hero-content">
        <a href="/" class="hero-logo-link" aria-label="Página inicial da Clean Energy">
          <img src="/imagem/logo-curva.svg" alt="Clean Energy" class="hero-logo-img" />
        </a>
        <h1 class="hero-title">Crie uma nova senha</h1>
        <p class="hero-subtitle">
          Escolha uma senha forte para manter sua conta protegida.
        </p>
      </header>
    </aside>

    <section class="form-section">
      <header class="form-header">
        <h2 class="form-title">Redefinir senha</h2>
        <p class="form-subtitle">Defina sua nova senha de acesso</p>
      </header>

      <% if (sucesso) { %>
        <section class="backend-error" role="status" style="background:#e8f5e8; color:#28530b; border-color:#28530b;">
          <i class='bx bx-check-circle'></i>
          <span>Senha redefinida com sucesso! Agora você já pode entrar com sua nova senha.</span>
        </section>
        <footer class="form-footer" style="margin-top: 20px;">
          <p class="register-link"><a href="/login">Ir para o login</a></p>
        </footer>
      <% } else if (!tokenValido) { %>
        <section class="backend-error" role="alert">
          <i class='bx bx-error-circle'></i>
          <span><%= erro %></span>
        </section>
        <footer class="form-footer" style="margin-top: 20px;">
          <p class="register-link"><a href="/recuperar-senha">Solicitar novo link</a></p>
        </footer>
      <% } else { %>
        <form action="/redefinir-senha/<%= token %>" method="POST" class="login-form" novalidate aria-label="Formulário de redefinição de senha">
          <fieldset class="form-fieldset">
            <legend class="sr-only">Nova senha</legend>

            <section class="input-group">
              <label for="senha" class="input-label">
                <i class='bx bx-lock-alt'></i>
                Nova senha
              </label>
              <section class="input-wrapper">
                <input
                  type="password"
                  id="senha"
                  name="senha"
                  class="form-input <%= erro ? 'erro' : '' %>"
                  placeholder="Digite sua nova senha"
                  autocomplete="new-password"
                  minlength="8"
                  required
                />
                <i class='bx bx-lock-alt input-icon'></i>
              </section>
              <small class="input-help">Mínimo de 8 caracteres</small>
            </section>

            <section class="input-group">
              <label for="confirmarSenha" class="input-label">
                <i class='bx bx-lock-alt'></i>
                Confirmar nova senha
              </label>
              <section class="input-wrapper">
                <input
                  type="password"
                  id="confirmarSenha"
                  name="confirmarSenha"
                  class="form-input <%= erro ? 'erro' : '' %>"
                  placeholder="Digite novamente a nova senha"
                  autocomplete="new-password"
                  minlength="8"
                  required
                />
                <i class='bx bx-lock-alt input-icon'></i>
              </section>
            </section>

            <% if (erro) { %>
            <section class="backend-error" role="alert">
              <i class='bx bx-error-circle'></i>
              <span><%= erro %></span>
            </section>
            <% } %>
          </fieldset>

          <button type="submit" class="submit-btn">
            <i class='bx bx-check'></i>
            <span>Redefinir senha</span>
          </button>
        </form>
      <% } %>
    </section>
  </main>

  <script src="/js/darkmode.js"></script>
  <script src="/js/pwa.js" defer></script>
</body>
</html>
